{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "target": "esnext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["esnext", "DOM", "DOM.Iterable"]
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "build",
    ".vercel",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/svelte.config.js"
  ],
  "include": [
    "apps/**/*.ts",
    "apps/**/*.js",
    "apps/**/*.svelte",
    "apps/**/*.d.ts",
    "packages/**/*.ts",
    "packages/**/*.js",
    "packages/**/*.svelte",
    "packages/**/*.d.ts"
  ]
}
