{
  "name": "camball.io",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:archive": "pnpm --filter @camball/archive dev",
    "dev:blog": "pnpm --filter @camball/blog dev",
    "dev:contact": "pnpm --filter @camball/contact dev",
    "dev:main": "pnpm --filter @camball/main dev",
    "dev:resume": "pnpm --filter @camball/resume dev",
    "build": "concurrently --kill-others-on-fail \"pnpm:build:*\"",
    "build:archive": "pnpm --filter @camball/archive build",
    "build:blog": "pnpm --filter @camball/blog build",
    "build:contact": "pnpm --filter @camball/contact build",
    "build:main": "pnpm --filter @camball/main build",
    "build:resume": "pnpm --filter @camball/resume build",
    "preview:archive": "pnpm --filter @camball/archive preview",
    "preview:blog": "pnpm --filter @camball/blog preview",
    "preview:contact": "pnpm --filter @camball/contact preview",
    "preview:main": "pnpm --filter @camball/main preview",
    "preview:resume": "pnpm --filter @camball/resume preview",
    "check": "concurrently --kill-others-on-fail \"pnpm:check:*\"",
    "check:archive": "pnpm --filter @camball/archive check",
    "check:blog": "pnpm --filter @camball/blog check",
    "check:contact": "pnpm --filter @camball/contact check",
    "check:main": "pnpm --filter @camball/main check",
    "check:resume": "pnpm --filter @camball/resume check",
    "test": "vitest",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^24"
  }
}
